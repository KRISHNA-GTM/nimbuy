---
// The audit UI. Its behaviour lives in public/js/listing-check.js and keys off these ids and
// class names (check-form, check-input, check-result, .field-more, .check-error, data-example).
---
<div class="tool" id="check">
  <div class="tool-bar" aria-hidden="true"><i></i><i></i><i></i><span>nimbuy / listing-audit</span></div>
  <div id="check-input" class="tool-body">
    <h2 class="tool-title">Paste your listing</h2>
    <form id="check-form" novalidate>
      <p class="examples" style="margin-top:0.6rem">Or try an example:
        <button type="button" class="chip-btn" data-example="before">Weak listing</button>
        <button type="button" class="chip-btn" data-example="after">Rewritten listing</button>
      </p>
      <label class="field">Product title
        <input name="title" type="text" autocomplete="off" placeholder="As it appears on AWS Marketplace" />
      </label>
      <label class="field">Short description
        <textarea name="short" rows="2" placeholder="The one or two lines under the title"></textarea>
      </label>
      <label class="field">Highlights <span>one per line</span>
        <textarea name="highlights" rows="3"></textarea>
      </label>
      <label class="field-check field-check-hint"><input name="agent" type="checkbox" /> <span>AI agents call this product (MCP server, A2A or an agent API)<small>Leave it unticked and Protocol &amp; category fit is left out of your score, so you do not lose points for it.</small></span></label>
      <details class="field-more">
        <summary>Add long description and pricing for a full score</summary>
        <label class="field">Long description
          <textarea name="long" rows="4"></textarea>
        </label>
        <div class="field-row">
          <label class="field">Pricing model
            <select name="model">
              <option value="">Not sure</option>
              <option value="contract">Contract (upfront)</option>
              <option value="usage">Usage (pay as you go)</option>
              <option value="free">Free only</option>
            </select>
          </label>
          <label class="field">Pricing unit
            <select name="unit">
              <option value="">Not sure</option>
              <option>Units</option>
              <option>Users</option>
              <option>Requests</option>
              <option>Hosts</option>
              <option>Data</option>
              <option>Bandwidth</option>
            </select>
          </label>
        </div>
        <label class="field">Pricing dimension description <span>the line under the price</span>
          <input name="dimDesc" type="text" autocomplete="off" />
        </label>
        <label class="field-check"><input name="privateOffer" type="checkbox" /> Buyers can request a private offer on the listing</label>
      </details>
      <p class="check-error" role="alert"></p>
      <button class="btn btn-primary btn-block" type="submit">Score my listing</button>
      <p class="tool-note">Copy the text from your public listing page. Title and short description are enough to start. The audit runs in your browser; nothing you paste is sent or stored.</p>
    </form>
  </div>
  <div id="check-result" class="tool-body tool-result" tabindex="-1" hidden aria-live="polite"></div>
</div>


<script is:inline define:vars={{ offers: import.meta.env.BASE_URL.replace(/[/]$/, "") + "/offers/" }}>window.NB_OFFERS = offers;</script>
<script is:inline src="/js/listing-benchmark.js" defer></script>
<script is:inline src="/js/listing-check.js" defer></script>
