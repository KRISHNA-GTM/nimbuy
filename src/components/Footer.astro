---
import { SITE } from '../config';
const year = new Date().getFullYear();
const prefix = import.meta.env.BASE_URL.replace(/[/]$/, '');
---
<footer class="footer">
  <div class="wrap footer-inner">
    <div class="footer-brand">
      <img src={`${prefix}/assets/nimbuy-wordmark.svg`} alt="Nimbuy" width="80" height="24" />
      <p>AWS Marketplace listing rewrites. <a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
    </div>
    <ul class="footer-links">
      <li><a href="/check/">Free check</a></li>
      <li><a href="/rewrite/">The rewrite</a></li>
      <li><a href="/data/">The data</a></li>
      <li><a href={SITE.linkedin} target="_blank" rel="noopener">LinkedIn</a></li>
      <li><a href="/privacy/">Privacy</a></li>
      <li><a href="/terms/">Terms</a></li>
    </ul>
    <p>© {year} Nimbuy</p>
  </div>
</footer>
