---
// Sticky-pin storytelling: the diagram pins, the four reader blocks scroll past it,
// and the matching lane lights up. IntersectionObserver only — no scroll-jacking,
// and on narrow screens it degrades to a plain stacked list with every lane lit.
const readers = [
  {
    n: '01', name: 'Security reviewer', sub: 'Opens your listing with a questionnaire already in hand',
    body: 'They are not browsing. They are filling in a form, and every answer your page does not give becomes an email to you. Each email costs days.',
    qs: ['Where is customer data stored, and can we choose?', 'Which report can you share — SOC 2, ISO 27001?', 'How long is data kept, and is it used to train models?'],
  },
  {
    n: '02', name: 'Procurement analyst', sub: 'Needs a number they can explain to finance',
    body: 'They compare you against a vendor whose pricing they can read. If your only unit is “Units” and the description is blank, you are the harder option.',
    qs: ['What exactly is one pricing unit?', 'What happens if we go over what we bought?', 'What support and SLA come at this price?'],
  },
  {
    n: '03', name: 'Technical evaluator', sub: 'Wants to know it fits before anyone signs anything',
    body: '“Integrates with your cloud” tells them nothing. “Reads from Amazon S3, writes to Amazon Redshift” answers the question in nine words.',
    qs: ['How is it deployed, and what do we need first?', 'Which AWS services does it connect to, by name?', 'How long from subscribing to a first working result?'],
  },
  {
    n: '04', name: 'AI search', sub: 'Summarises your listing to a buyer who never opens it',
    body: 'An assistant can only repeat what is written. If your first sentence is about your company rather than the job the product does, that is what gets repeated.',
    qs: ['In one sentence, what does it do and for whom?', 'Which use cases, in the buyer’s own words?', 'What evidence backs the claims — a number with a date?'],
  },
];
---
<div class="readers">
  <div class="readers-pin">
    <div class="reader-diagram">
      {readers.map((r, i) => (
        <div class="lane" class:list={[{ 'is-on': i === 0 }]} data-lane={i}>
          <span class="lane-n">{r.n}</span>
          <span><b>{r.name}</b><span>{r.sub}</span></span>
        </div>
      ))}
    </div>
  </div>
  <div class="reader-steps">
    {readers.map((r, i) => (
      <article class="reader-step" data-step={i}>
        <h3>{r.n} · {r.name}</h3>
        <p>{r.body}</p>
        <div class="q">{r.qs.map((q) => <i>{q}</i>)}</div>
      </article>
    ))}
  </div>
</div>

<script>
  // Which reader block is nearest the middle of the viewport lights its lane.
  // rAF-throttled scroll maths rather than IntersectionObserver: deterministic,
  // testable, and it recovers correctly after any resize or layout shift.
  const steps = [...document.querySelectorAll<HTMLElement>('[data-step]')];
  const lanes = [...document.querySelectorAll<HTMLElement>('[data-lane]')];

  function activeIndex(): number {
    const mid = window.innerHeight / 2;
    let best = 0;
    let bestDist = Infinity;
    steps.forEach((s, i) => {
      const r = s.getBoundingClientRect();
      const d = Math.abs(r.top + r.height / 2 - mid);
      if (d < bestDist) { bestDist = d; best = i; }
    });
    return best;
  }

  function paint() {
    const i = activeIndex();
    lanes.forEach((l, j) => l.classList.toggle('is-on', i === j));
  }

  if (steps.length && lanes.length) {
    let queued = false;
    const onScroll = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => { queued = false; paint(); });
    };
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll, { passive: true });
    paint();
    (window as any).NB_READERS = { activeIndex, paint };
  }
</script>
