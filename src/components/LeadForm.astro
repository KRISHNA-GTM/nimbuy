---
// One form. Sends to the HubSpot "brief" form when configured, otherwise opens a
// ready-written email. Nothing is stored by this site.
const consent = 'I agree that Nimbuy may store these details to reply to my enquiry. See the privacy policy.';
---
<div class="form-card" id="brief">
  <h3>Send a short brief</h3>
  <p style="font-size:0.95rem">You get the scope and an invoice in writing within one business day. No call needed.</p>
  <form data-form="brief" data-subject="Nimbuy brief" data-consent={consent} style="margin-top:0.75rem">
    <input class="hp" type="text" name="website_hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <div class="field-row">
      <label class="field">Your name<input name="name" type="text" required autocomplete="name" /></label>
      <label class="field">Work email<input name="email" type="email" required autocomplete="email" /></label>
    </div>
    <label class="field">Company<input name="company" type="text" required autocomplete="organization" /></label>
    <label class="field">Marketplace listing URL<input name="listing_url" type="url" placeholder="https://aws.amazon.com/marketplace/pp/prodview-…" /></label>
    <label class="field">Anything I should know <span>optional</span><textarea name="message" rows="3" placeholder="A live AWS deal, a deadline, what has not worked so far"></textarea></label>
    <label class="consent"><input type="checkbox" name="consent" required /><span>I agree that Nimbuy may store these details to reply. <a href="/privacy/">Privacy policy</a>.</span></label>
    <p class="form-error" role="alert"></p>
    <button class="btn btn-primary btn-block" type="submit">Send the brief</button>
  </form>
  <p class="form-ok" data-ok hidden tabindex="-1">Brief received. You will get the scope and an invoice within one business day.</p>
</div>
