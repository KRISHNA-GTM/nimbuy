---
import { FACTS, BENCH } from '../data/facts';
interface Props { all?: boolean; }
const { all = false } = Astro.props;
const list = all ? FACTS : FACTS.slice(0, 3);
---
<div class="facts">
  {list.map((f) => (
    <div class="fact reveal">
      <p class="fact-n num">{f.n}<sup>%</sup></p>
      <h3>{f.label}</h3>
      <p>{f.note}</p>
    </div>
  ))}
</div>
<p class="source-note">
  SOURCE · AWS Marketplace Discovery API, snapshot {BENCH.snapshot}. Every SaaS listing in every category, at most two per seller
  (n = {BENCH.n.toLocaleString('en-US')}). Public listing data only; counts of observable fields, not opinions about any product.
</p>
