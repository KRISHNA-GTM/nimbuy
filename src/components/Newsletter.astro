---
interface Props { source: string; dark?: boolean; }
const { source, dark = false } = Astro.props;
const consent = 'I agree to receive the Nimbuy newsletter and can unsubscribe at any time. See the privacy policy.';
---
<div>
  <form class:list={['nl', { 'nl-dark': dark }]} data-form="newsletter" data-subject="Newsletter signup" data-consent={consent}>
    <input type="hidden" name="source" value={`newsletter:${source}`} />
    <input class="hp" type="text" name="website_hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <input id={`nl-${source}`} type="email" name="email" required autocomplete="email" placeholder="you@company.com" aria-label="Email address" />
    <button class="btn btn-mint btn-small" type="submit">Subscribe</button>
    <label class="consent" style="flex-basis:100%;margin-top:0.25rem">
      <input type="checkbox" name="consent" required />
      <span>One email when something worth reading is published. Unsubscribe any time. <a href="/privacy/">Privacy</a>.</span>
    </label>
    <p class="form-error" role="alert" style="flex-basis:100%"></p>
  </form>
  <p class="form-ok" data-ok hidden tabindex="-1">You are on the list. Check your inbox to confirm.</p>
</div>
