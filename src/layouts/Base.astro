---
import '../styles/global.css';
import { SITE } from '../config';
import Footer from '../components/Footer.astro';
interface Props { title: string; description: string; noindex?: boolean; tone?: 'light' | 'dark'; }
const { title, description, noindex = false, tone = 'light' } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
const prefix = baseUrl.endsWith('/') ? baseUrl.slice(0, -1) : baseUrl;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const og = new URL(`${prefix}/assets/og.png`, SITE.url).href;
const links = [
  { href: '/check/', label: 'Free check' },
  { href: '/rewrite/', label: 'The rewrite' },
  { href: '/data/', label: 'The data' },
];
const here = Astro.url.pathname.startsWith(prefix) ? Astro.url.pathname.slice(prefix.length) || '/' : Astro.url.pathname;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#0c0914" />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Nimbuy" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={og} />
  <meta property="og:url" content={canonical} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" href={`${prefix}/assets/favicon.svg`} type="image/svg+xml" />
  <link rel="apple-touch-icon" href={`${prefix}/assets/apple-touch-icon.png`} />
  <link rel="sitemap" href={`${prefix}/sitemap-index.xml`} />
</head>
<body data-tone={tone === 'dark' ? 'dark' : undefined}>
  <a class="skip" href="#main">Skip to content</a>
  <header class="nav">
    <div class="nav-inner">
      <a class="brand" href="/" aria-label="Nimbuy, home">
        <img src={tone === 'dark' ? `${prefix}/assets/nimbuy-wordmark-white.svg` : `${prefix}/assets/nimbuy-wordmark.svg`} alt="Nimbuy" width="88" height="26" />
      </a>
      <nav aria-label="Main">
        <ul class="nav-links">
          {links.map((l) => <li><a href={l.href} aria-current={here.startsWith(l.href) ? 'page' : undefined}>{l.label}</a></li>)}
          <li class="nav-m"><a href="/book/">Book a call</a></li>
        </ul>
      </nav>
      <div class="nav-cta"><a class="btn btn-primary btn-small" href="/book/">Book a call</a></div>
      <button class="nav-toggle" type="button" aria-expanded="false">Menu</button>
    </div>
  </header>
  <main id="main"><slot /></main>
  <Footer />
  <script src="../scripts/site.ts"></script>
  <script src="../scripts/forms.ts"></script>
</body>
</html>
