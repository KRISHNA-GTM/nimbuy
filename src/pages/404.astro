---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found | Nimbuy" description="That page does not exist." noindex>
  <section class="page-hero">
    <div class="wrap">
      <p class="label">404</p>
      <h1>That page is not here.</h1>
      <p class="lead" style="max-width:48ch">It may have moved. Try the free audit, or head back to the start.</p>
      <div class="hero-actions"><a class="btn btn-primary" href="/audit/">Run the free audit</a><a class="btn btn-outline" href="/">Home</a></div>
    </div>
  </section>
</Base>
