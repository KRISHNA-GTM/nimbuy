---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found | Nimbuy" description="That page does not exist." noindex>
  <section class="page-hero" style="border:0">
    <div class="wrap">
      <p class="label">404</p>
      <h1>That page is not here.</h1>
      <p class="lead">It may have moved. The free check is probably what you were after.</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/check/">Check a listing</a>
        <a class="btn btn-ghost" href="/">Home</a>
      </div>
    </div>
  </section>
</Base>
