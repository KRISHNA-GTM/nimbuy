---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import AuditTool from '../components/AuditTool.astro';
import MarketFacts from '../components/MarketFacts.astro';
import Offers from '../components/Offers.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { BENCH } from '../data/facts';
import { SITE } from '../config';

const posts = (await getCollection('blog')).sort((a, b) => +b.data.date - +a.data.date).slice(0, 3);
const readers = [
  ['Security reviewer', 'Where is customer data stored? Which reports can you share? How is data deleted?', '01'],
  ['Procurement', 'What exactly is one pricing unit? What happens if we go over? What support comes with the price?', '02'],
  ['Technical evaluator', 'How is it deployed? Which AWS services does it connect to? How long to the first working result?', '03'],
  ['AI search', 'What does it do, for whom, and what evidence backs the claims? Written so a model can summarise it.', '04'],
];
---
<Base
  title="Nimbuy | AWS Marketplace listing audit, rewrite and launch"
  description={`Free AWS Marketplace listing audit: a score out of 100 on 7 dimensions, your position against ${BENCH.count} live listings, and your top 3 fixes. Then Nimbuy rewrites or launches it.`}
>
  <section class="hero dark grid-bg">
    <div class="wrap hero-grid">
      <div>
        <p class="label">AWS Marketplace listings</p>
        <h1>Four people read your listing before a deal. <em>Does it answer them?</em></h1>
        <p class="lead">Security, procurement, a technical evaluator and AI search each look for different things. Score your listing in about a minute, then close the gaps.</p>
        <div class="hero-actions">
          <a class="btn btn-mint" href="#check">Score my listing <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 8h10M9 4l4 4-4 4"/></svg></a>
          <a class="btn btn-ghost-dark" href="/offers/">See offers</a>
        </div>
        <ul class="statline">
          <li><strong class="num">{BENCH.count}</strong>live listings benchmarked</li>
          <li><strong class="num">7</strong>dimensions scored</li>
          <li><strong>Free</strong>runs in your browser</li>
        </ul>
      </div>
      <div class="reveal"><AuditTool /></div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="label">The four readers</p>
          <h2>A listing is read by people who never talk to each other.</h2>
        </div>
        <p class="section-aside">Most listings are written for none of them. Each reader has three questions that stop or stall a deal.</p>
      </div>
      <div class="cards-2">
        {readers.map(([t, q, i]) => (
          <article class="card reveal">
            <span class="idx">READER {i}</span>
            <h3>{t}</h3>
            <p>{q}</p>
          </article>
        ))}
      </div>
      <p style="margin-top:1.5rem"><a class="arrow-link" href="/blog/the-four-readers-of-your-aws-marketplace-listing/">The 12 questions, in full →</a></p>
    </div>
  </section>

  <section class="section dark grid-bg">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="label">What {BENCH.count} live listings show</p>
          <h2>Most listings leave the basics off the page.</h2>
        </div>
        <p class="section-aside">Counts of fields anyone can check on the public listing. Not opinions about any product.</p>
      </div>
      <MarketFacts />
      <figure class="market">
        <figcaption><strong>How live listings score on the automatic audit</strong><span>Typical: <b>{BENCH.median}</b> · Top 10% starts at <b>{BENCH.p90}</b> · Best: <b>{BENCH.max}</b></span></figcaption>
        <div id="market-chart" class="market-chart"></div>
        <p class="market-note">Score your listing above and your position appears on this chart.</p>
      </figure>
      <p style="margin-top:1.5rem"><a class="arrow-link" href="/insights/">All the numbers and how they were built →</a></p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="label">One rewrite</p>
          <h2>Same product. Different page.</h2>
        </div>
        <p class="section-aside">A made-up product, scored by the same audit. The rewrite uses only facts the seller could prove.</p>
      </div>
      <div class="ba">
        <article class="ba-card ba-before reveal">
          <p class="ba-tag">Before</p>
          <h3>Northwind AI Platform</h3>
          <p class="ba-short">Northwind is the leading, most powerful AI platform that transforms how enterprises work with data.</p>
          <ul>
            <li>Revolutionary AI-powered insights</li>
            <li>Seamless integration with your stack</li>
            <li>Enterprise-grade security</li>
          </ul>
          <p class="ba-meta">Pricing unit: Units · no price description · private offers off</p>
        </article>
        <div class="ba-score" aria-label="Score before and after">
          <span><small>BEFORE</small><strong data-sample-score="before">12</strong></span>
          <span class="ba-arrow" aria-hidden="true">→</span>
          <span><small>AFTER</small><strong class="ba-after-num" data-sample-score="after">88</strong></span>
        </div>
        <article class="ba-card ba-after reveal">
          <p class="ba-tag ba-tag-after">After</p>
          <h3>Northwind Data Cloud – plain-English analytics for Amazon Redshift</h3>
          <p class="ba-short">Lets finance and operations teams ask questions of their Amazon Redshift data in plain English and get a chart in under 10 seconds, with no SQL.</p>
          <ul>
            <li>Connects to Amazon Redshift and PostgreSQL in about 15 minutes</li>
            <li>SOC 2 Type II; data stays in your AWS region and is never used for training</li>
            <li>Priced per user per month: 1 unit = 1 named user</li>
          </ul>
          <p class="ba-meta">Pricing unit: Users · price line: “One named user with full query and dashboard access, billed monthly”</p>
        </article>
      </div>
      <p style="margin-top:1.5rem"><a class="arrow-link" href="/sample/">See the full sample deliverable →</a></p>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="label">Offers</p>
          <h2>Pick the level of help.</h2>
        </div>
        <p class="section-aside">Fixed scope, fixed price, written down before work starts.</p>
      </div>
      <Offers />
      <p style="margin-top:1.5rem"><a class="arrow-link" href="/offers/">Compare offers in detail →</a></p>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="wrap">
      <div class="who reveal">
        <picture class="who-photo">
          <source type="image/webp" srcset="/assets/krishna-720.webp" />
          <img src="/assets/krishna-720.jpg" width="720" height="832" alt={`Portrait of ${SITE.founder}`} loading="lazy" decoding="async" />
        </picture>
        <div class="who-copy">
          <p class="label">Who does the work</p>
          <h2>{SITE.founder}</h2>
          <p class="who-role">Founder, Nimbuy · every audit and rewrite is done by hand</p>
          <ul class="who-facts">
            <li>Built the benchmark: <strong>{BENCH.count} live listings</strong> read through the AWS Marketplace Discovery API</li>
            <li>Works on AWS Marketplace listings, AWS competency documentation and partner go-to-market</li>
            <li><strong>AWS Certified Cloud Practitioner</strong>, plus AWS Partner Sales and Technical accreditations</li>
          </ul>
          <div class="who-links">
            <a class="btn btn-outline btn-small" href="/about/">About</a>
            <a class="btn btn-outline btn-small" href={SITE.linkedin} target="_blank" rel="noopener">LinkedIn</a>
            <a class="btn btn-outline btn-small" href={SITE.credly} target="_blank" rel="noopener">Verify badges on Credly</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="section" style="padding-top:0">
      <div class="wrap">
        <div class="section-head">
          <div>
            <p class="label">From the blog</p>
            <h2>Findings, not filler.</h2>
          </div>
          <p class="section-aside"><a class="arrow-link" href="/blog/">All posts →</a></p>
        </div>
        <div class="cards-3">
          {posts.map((p) => (
            <a class="card card-link post-card reveal" href={`/blog/${p.id}/`}>
              <span class="idx tag">{p.data.tag.toUpperCase()}</span>
              <h3>{p.data.title}</h3>
              <p>{p.data.description}</p>
              <div class="meta"><span>{p.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}</span><span>{p.data.readMinutes} min read</span></div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section" style="padding-top:0">
    <Faq />
  </section>

  <CtaBand />
</Base>
