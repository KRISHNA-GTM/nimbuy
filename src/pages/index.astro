---
import Base from '../layouts/Base.astro';
import FourReaders from '../components/FourReaders.astro';
import { SITE } from '../config';
import { BENCH, CENSUS, GAPS, HAND, ABOVE_70 } from '../data/facts';
const prefix = import.meta.env.BASE_URL.replace(/[/]$/, '');
const faq = [
  ['What do I actually get?', 'A one-page audit marking each of the 12 reviewer questions Yes, Partly or No with your own listing text quoted as evidence, plus every listing field rewritten and ready to use. Three business days.'],
  ['Do you need access to our AWS account?', 'No. You paste the new copy yourself, or you grant temporary access and I enter it — your choice. Nothing I do needs standing access.'],
  ['What if we cannot prove a claim?', 'It stays off the listing. I write from facts you can evidence: a certification you can show, a region you actually use, a number with a date. That rule is the whole product.'],
  ['Is this an AWS score or an AWS service?', 'Neither. Nimbuy is independent of AWS. The check is my own read of your public listing text, and it does not predict AWS approval, search placement or sales.'],
  ['Our product is not an AI agent. Does this apply?', 'Yes. Six of the seven dimensions apply to any product on Marketplace. The agent dimension only counts if you tick that box.'],
  ['Why not have AI rewrite it?', 'A model will happily write “enterprise-grade security” for you. It does not know which reviewer question your listing leaves open, or which of your claims you can actually back up.'],
];
---
<Base
  title="Nimbuy — your AWS Marketplace listing, rewritten for the people who review it"
  description={`Four people read your AWS Marketplace listing before a deal. Most listings answer none of them. A hand audit against 12 reviewer questions plus a full rewrite, in three business days. Built on a census of ${CENSUS.totalLabel} listings.`}
>
  <!-- HERO: copy left, the real deliverable right -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="label">AWS Marketplace</p>
        <h1>Four people read your listing before a deal.</h1>
        <p class="lead">
          A security reviewer, a procurement analyst, an engineer, and an AI assistant summarising
          you to a buyer who never opens the page. I read your listing as all four, then rewrite it
          so each one finds their answer.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/rewrite/">What you get for $500 <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 8h10M9 4l4 4-4 4"/></svg></a>
          <a class="btn btn-ghost" href="/check/">Check your listing free</a>
        </div>
        <ul class="statline">
          <li><strong>{CENSUS.totalLabel}</strong>listings read to build this</li>
          <li><strong>12</strong>reviewer questions</li>
          <li><strong>3 days</strong>from brief to rewritten</li>
        </ul>
      </div>
      <figure class="artifact reveal">
        <img src={`${prefix}/assets/deliverable.png`} width="860" height="1120" alt="Page one of a Nimbuy listing audit: reviewer questions answered, listing score, what each of the four readers finds, score by dimension, and rewritten fields." fetchpriority="high" />
        <figcaption>Page one of the audit. Worked example — Northwind is not a real seller.</figcaption>
      </figure>
    </div>
  </section>

  <!-- THE FOUR READERS: sticky-pin -->
  <section class="section tint">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="label">Who reads it</p>
          <h2>Four readers. None of them talk to each other.</h2>
        </div>
        <p class="section-aside">Most listings are written once, at launch, for a buyer who does not exist. These four are the ones who actually decide.</p>
      </div>
      <FourReaders />
    </div>
  </section>

  <!-- THE EVIDENCE -->
  <section class="section" data-tone="dark">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="label">What the listings show</p>
          <h2>It is almost never the writing. It is three empty boxes.</h2>
        </div>
        <p class="section-aside">
          I read every live SaaS listing on AWS Marketplace and scored {BENCH.nExact} of them,
          capped at two per seller. The gap between a typical listing and a top one is not prose quality.
        </p>
      </div>
      <div class="gapgrid">
        {GAPS.map((g) => (
          <article class="gapcard reveal">
            <p class="pct">{g.typical}<em>%</em></p>
            <h3>of typical listings {g.head}</h3>
            <p>{g.body}</p>
            <div class="meter"><i style={`width:${g.typical}%`}></i></div>
            <p style="margin-top:0.6rem;font-size:0.84rem">Among the best-scoring listings: <strong>{g.best}%</strong></p>
          </article>
        ))}
      </div>
      <p class="source-note">
        Only <strong>{ABOVE_70} of {BENCH.nExact}</strong> listings score above 70. Separately, I hand-scored {HAND.n} listings
        across every delivery type: the single weakest area is security in {HAND.weakest[0][1]}%, pricing in {HAND.weakest[1][1]}%
        and deployment in {HAND.weakest[2][1]}% — so in {HAND.topThreeShare}% of listings the worst gap is one of those three.
      </p>
      <p style="margin-top:1.5rem"><a class="arrow-link" href="/data/">How the numbers were built →</a></p>
    </div>
  </section>

  <!-- THE OFFER -->
  <section class="section">
    <div class="wrap two-col">
      <div>
        <p class="label">The rewrite</p>
        <h2 style="margin-top:0.9rem">One thing, done properly.</h2>
        <p style="margin-top:1.2rem;font-size:1.1rem">
          I audit your listing by hand against the 12 questions those four readers ask, quote your own
          text as evidence for every mark, then rewrite every field from facts you can prove.
        </p>
        <p style="margin-top:1rem">
          Not a subscription, not a dashboard, not a model's draft. One person reading your page the way
          a reviewer will, and writing what should be there instead.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/rewrite/">See the full scope</a>
        </div>
      </div>
      <div class="offer-card">
        <p class="label">Listing rewrite</p>
        <p class="price" style="margin-top:0.8rem">$500<em>fixed</em></p>
        <p class="price-anchor">About five hours of specialist work. Paid upfront, one revision round, three business days from your brief.</p>
        <ul class="deliver">
          <li><span><b>The audit</b><span>12 reviewer questions marked Yes / Partly / No, each with your listing's own words quoted.</span></span></li>
          <li><span><b>The rewrite</b><span>Title, short and long description, highlights, keywords, pricing wording — every field, written out.</span></span></li>
          <li><span><b>Your facts only</b><span>Anything you cannot evidence stays off the page.</span></span></li>
        </ul>
      </div>
    </div>
  </section>

  <!-- WHO -->
  <section class="section tint">
    <div class="wrap who">
      <img src={`${prefix}/assets/krishna-720.jpg`} width="720" height="832" alt={`Portrait of ${SITE.founder}`} loading="lazy" decoding="async" />
      <div>
        <p class="label">Who does the work</p>
        <h2 style="margin-top:0.8rem;font-size:clamp(1.8rem,3vw,2.4rem)">{SITE.founder}</h2>
        <p style="margin-top:0.8rem">
          Every audit and every rewrite is mine, by hand. I built the {CENSUS.totalLabel}-listing census this site
          runs on, and I work on Marketplace listings, AWS competency documentation and partner go-to-market.
        </p>
        <ul class="who-facts">
          <li>AWS Certified Cloud Practitioner, plus AWS Partner Sales and Technical accreditations</li>
          <li>No case studies yet — this is a new practice, and I would rather say so than imply otherwise</li>
        </ul>
        <div class="who-links">
          <a class="btn btn-ghost btn-small" href={SITE.linkedin} target="_blank" rel="noopener">LinkedIn</a>
          <a class="btn btn-ghost btn-small" href={SITE.credly} target="_blank" rel="noopener">Verify badges</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap faq-wrap">
      <div>
        <p class="label">Questions</p>
        <h2 style="margin-top:0.9rem">Straight answers.</h2>
      </div>
      <div class="faq">{faq.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}</div>
    </div>
  </section>

  <section class="section" data-tone="dark">
    <div class="wrap two-col" style="align-items:center">
      <div>
        <p class="label">Start</p>
        <h2 style="margin-top:0.9rem;max-width:17ch">Find out which reader your listing fails first.</h2>
      </div>
      <div class="hero-actions" style="margin:0">
        <a class="btn btn-primary" href="/check/">Check it free <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 8h10M9 4l4 4-4 4"/></svg></a>
        <a class="btn btn-ghost" href="/book/">Book a call</a>
      </div>
    </div>
  </section>
</Base>
