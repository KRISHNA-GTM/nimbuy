---
import Base from '../layouts/Base.astro';
import MarketFacts from '../components/MarketFacts.astro';
import CtaBand from '../components/CtaBand.astro';
import Newsletter from '../components/Newsletter.astro';
import { BENCH } from '../data/facts';
---
<Base title="AWS Marketplace listing insights | Nimbuy" description={`What ${BENCH.count} live AWS Marketplace SaaS listings leave out: pricing units, AWS services, security terms, setup language, reviews and MCP. Public data, aggregates only.`}>
  <section class="page-hero dark grid-bg">
    <div class="wrap">
      <p class="label">Insights</p>
      <h1>What {BENCH.count} live listings leave out.</h1>
      <p class="lead" style="max-width:58ch">Every live SaaS listing in AWS Marketplace, read through the public Discovery API. At most two per seller. Counts of fields anyone can check, not opinions about any product.</p>
    </div>
  </section>

  <section class="section dark grid-bg" style="padding-top:0">
    <div class="wrap">
      <MarketFacts all />
    </div>
  </section>

  <section class="section">
    <div class="wrap two-col">
      <div>
        <p class="label">How this was built</p>
        <h2 style="margin-top:0.9rem">Method, and what it cannot tell you.</h2>
        <ul class="who-facts" style="margin-top:1.5rem">
          <li><strong>Source:</strong> AWS Marketplace Discovery API, read-only, public data. Snapshot {BENCH.snapshot}.</li>
          <li><strong>Population:</strong> every live SaaS listing in every category, capped at two per seller so large sellers do not skew it. n = {BENCH.n.toLocaleString('en-US')}.</li>
          <li><strong>Checks:</strong> fixed word and field checks, applied identically to every listing.</li>
          <li><strong>Publication rule:</strong> only aggregates. No single listing's score is published.</li>
        </ul>
      </div>
      <div class="notice">
        <p class="label" style="margin-bottom:0.75rem">Limits</p>
        <p style="color:var(--body)"><strong>Keyword checks produce false negatives.</strong> A listing can describe its security in words the checker does not match. We have not measured how often. Read each percentage as “missing, as far as a word-and-field check can tell”.</p>
        <p style="margin-top:0.8rem;color:var(--body)"><strong>The score is not a rating of the product.</strong> A good product can have a poor listing. It is not an AWS score and does not predict approval, search placement or sales.</p>
        <p style="margin-top:0.8rem;color:var(--body)"><strong>The “typical” score reflects the checker.</strong> It gives zero for anything it cannot match, so it runs low by design. Use it to place a listing, not to grade one.</p>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="wrap">
      <div class="form-card" style="max-width:640px">
        <h3>New data cuts, by email</h3>
        <p style="margin-bottom:1rem">When the benchmark is refreshed or a new cut is published, you hear about it once.</p>
        <Newsletter source="insights" />
      </div>
    </div>
  </section>
  <CtaBand />
</Base>
