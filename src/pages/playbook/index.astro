---
import Base from '../../layouts/Base.astro';
const consent = 'I agree that Nimbuy may email me the playbook and the occasional newsletter, and store my details for that. See the privacy policy.';
const toc: [string, string][] = [
  ['The method', 'Yes, Partly, No: how to mark a listing honestly'],
  ['Security reader', 'Questions 1–3, what a good answer holds and what to leave out'],
  ['Procurement reader', 'Questions 4–6, with the pricing-unit worksheet'],
  ['Technical reader', 'Questions 7–9, with the setup-sentence template'],
  ['AI search reader', 'Questions 10–12, with the first-twenty-words test'],
  ['Rewrite rules', 'Seven rules and the word list we cut'],
  ['Self-score sheet', 'Your “answers X of 12” count and what to do with it'],
];
---
<Base title="The Listing Readiness Playbook | Nimbuy" description="A practical worksheet for AWS Marketplace sellers: the four readers of your listing, the 12 questions that stall a deal, and the rewrite rules we use on audits.">
  <section class="page-hero dark grid-bg">
    <div class="wrap gate">
      <div>
        <p class="label">Playbook · free</p>
        <h1 style="max-width:14ch">The Listing Readiness Playbook.</h1>
        <p class="lead" style="max-width:52ch">The four readers of your AWS Marketplace listing, the 12 questions that stall a deal, and the rewrite rules we use on every audit. Worksheets included. About 20 minutes to work through on your own listing.</p>
        <div class="book-cover" style="margin-top:2.5rem" aria-hidden="true">
          <span class="bc-m">Nimbuy · Playbook</span>
          <span class="bc-t">Listing<br />Readiness<br /><em>Playbook</em></span>
          <span class="bc-m">4 readers · 12 questions · 7 rules</span>
        </div>
      </div>
      <div class="form-card" style="color:var(--body)">
        <h3>Get the playbook</h3>
        <p>Enter your email and it opens right here. We also send you the link, so you can keep it.</p>
        <form data-form="playbook" data-subject="Playbook download" data-consent={consent} style="margin-top:0.5rem">
          <input type="hidden" name="source" value="playbook-gate" />
          <input class="hp" type="text" name="website_hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <label class="field">Your name <span>optional</span><input name="name" type="text" autocomplete="given-name" /></label>
          <label class="field">Work email<input name="email" type="email" required autocomplete="email" /></label>
          <label class="field">Company <span>optional</span><input name="company" type="text" autocomplete="organization" /></label>
          <label class="consent"><input type="checkbox" name="consent" required /><span>I agree to receive the playbook and the occasional Nimbuy newsletter. Unsubscribe any time. <a href="/privacy/">Privacy policy</a>.</span></label>
          <p class="form-error" role="alert"></p>
          <button class="btn btn-primary btn-block" type="submit">Send me the playbook</button>
        </form>
        <div class="form-ok" data-ok hidden tabindex="-1">
          <p>You are in. <a href="/playbook/read/"><strong>Open the playbook →</strong></a></p>
          <p style="font-weight:400;margin-top:0.4rem">Use your browser's “Print → Save as PDF” on that page to keep a copy.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap two-col">
      <div>
        <p class="label">Inside</p>
        <h2 style="margin-top:0.9rem">Seven short parts.</h2>
        <p style="margin-top:1rem;color:var(--muted);max-width:44ch">It is a worksheet, not a lecture. Each part ends with something you fill in on your own listing.</p>
      </div>
      <ol class="toc">
        {toc.map(([t, d]) => <li><div>{t}<span>{d}</span></div></li>)}
      </ol>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="wrap">
      <div class="notice">
        <strong>No catch.</strong> The playbook uses the same method as the paid audit. Doing it yourself is a fair outcome; if you would rather have it done and written for you, <a href="/offers/">Listing Optimize</a> is $500.
      </div>
    </div>
  </section>
</Base>
