---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
const rows: [string, string, string, string][] = [
  ['1', 'Security', 'Where is customer data stored?', 'No'],
  ['2', 'Security', 'Which reports can you share?', 'Partly'],
  ['3', 'Security', 'Retention, deletion, model training?', 'No'],
  ['4', 'Procurement', 'What is one pricing unit?', 'No'],
  ['5', 'Procurement', 'What happens if we go over?', 'No'],
  ['6', 'Procurement', 'Support and SLA?', 'No'],
  ['7', 'Technical', 'Deployment and prerequisites?', 'Partly'],
  ['8', 'Technical', 'AWS services named?', 'No'],
  ['9', 'Technical', 'Time to first result?', 'No'],
  ['10', 'AI search', 'What it does and for whom?', 'Partly'],
  ['11', 'AI search', 'Use cases in buyer words?', 'No'],
  ['12', 'AI search', 'Evidence behind the claims?', 'No'],
];
const tone: Record<string, string> = { No: 'ep-opinion', Partly: 'ep-infer', Yes: 'ep-fact' };
---
<Base title="Sample deliverable: before and after | Nimbuy" description="A made-up product through the Nimbuy audit: the four-reader check, the answers-X-of-12 count, and the rewritten listing fields.">
  <section class="page-hero">
    <div class="wrap">
      <p class="label">Sample deliverable</p>
      <h1>What you receive, on a made-up product.</h1>
      <p class="lead" style="max-width:58ch">Northwind is fictional. The structure is exactly what a client gets: a four-reader check with quoted evidence, then the rewritten fields, ready to paste.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="label">Part 1 · The audit</p>
          <h2>The “before” answers 0 of 12 questions.</h2>
        </div>
        <p class="section-aside">Each mark is backed by a quoted sentence from the listing. A Yes you cannot quote is not a Yes.</p>
      </div>
      <div class="qtable">
        {rows.map(([n, who, q, a]) => (
          <div class="q-row"><span class="q-n">{n.padStart(2, '0')}</span><span class="q-who">{who}</span><span class="q-text">{q} <span class={`epistemic ${tone[a]}`} style="margin-left:0.5rem">{a}</span></span></div>
        ))}
      </div>
      <p class="source-note" style="color:var(--muted)">Sample tally: 0 Yes, 3 Partly, 9 No. “Partly” here means the listing gestures at an answer without stating it, for example “Enterprise-grade security” with no report named.</p>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="label">Part 2 · The rewrite</p>
          <h2>Field by field, paste-ready.</h2>
        </div>
        <p class="section-aside">Uses only facts the client supplies. Anything not supplied is left out, not guessed.</p>
      </div>
      <div class="ba">
        <article class="ba-card ba-before">
          <p class="ba-tag">Before · title and short description</p>
          <h3>Northwind AI Platform</h3>
          <p class="ba-short">Northwind is the leading, most powerful AI platform that transforms how enterprises work with data.</p>
          <ul>
            <li>Revolutionary AI-powered insights</li>
            <li>Seamless integration with your stack</li>
            <li>Enterprise-grade security</li>
          </ul>
        </article>
        <div class="ba-score"><span><small>BEFORE</small><strong>12</strong></span><span class="ba-arrow">→</span><span><small>AFTER</small><strong class="ba-after-num">88</strong></span></div>
        <article class="ba-card ba-after">
          <p class="ba-tag ba-tag-after">After · title and short description</p>
          <h3>Northwind Data Cloud – plain-English analytics for Amazon Redshift</h3>
          <p class="ba-short">Lets finance and operations teams ask questions of their Amazon Redshift data in plain English and get a chart in under 10 seconds, with no SQL.</p>
          <ul>
            <li>Connects to Amazon Redshift and PostgreSQL in about 15 minutes</li>
            <li>SOC 2 Type II; data stays in your AWS region and is never used for training</li>
            <li>Priced per user per month: 1 unit = 1 named user</li>
          </ul>
        </article>
      </div>

      <div class="cards-2" style="margin-top:2rem">
        <div class="card">
          <span class="idx">WHAT CHANGED · SECURITY</span>
          <h3>Three questions answered with one line</h3>
          <p>Region, certification and training use are stated in the second highlight. The long description adds encryption in transit and at rest, SSO and audit logs.</p>
        </div>
        <div class="card">
          <span class="idx">WHAT CHANGED · PRICING</span>
          <h3>“Units” becomes “named users”</h3>
          <p>One named user, what it includes and how it is billed, in the price line. Procurement can now estimate a budget without emailing anyone.</p>
        </div>
        <div class="card">
          <span class="idx">WHAT CHANGED · TECHNICAL</span>
          <h3>Services named, time stated</h3>
          <p>Amazon Redshift and PostgreSQL by name. Setup in about 15 minutes. A technical evaluator can judge fit from the first screen.</p>
        </div>
        <div class="card">
          <span class="idx">WHAT CHANGED · AI SEARCH</span>
          <h3>Who it is for, and the job it does</h3>
          <p>Finance and operations teams, plain-English questions, a chart in under 10 seconds. A model summarising the listing has a sentence it can quote.</p>
        </div>
      </div>
      <p class="source-note" style="color:var(--muted);margin-top:1.5rem">Scores come from the free audit run on both versions. The hand audit goes deeper than the automatic one. Northwind is fictional; no real company is described.</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/audit/">Score the two versions yourself</a>
        <a class="btn btn-outline" href="/book/?offer=optimize#brief">Get this for your listing</a>
      </div>
    </div>
  </section>
  <CtaBand />
</Base>
